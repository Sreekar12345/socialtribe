NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

DATABASE_URL=postgres://postgres:postgres@localhost:5432/socialtribe
CACHE_TTL_HOURS=24

SCRAPER_MODE=mock
SCRAPER_API_URL=
SCRAPER_API_TOKEN=
SOURCE_PROVIDER=mock-instagram-provider

INSTAGRAM_OAUTH_MODE=mock
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4000/api/v1/auth/instagram/callback
INSTAGRAM_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com/v21.0
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic
INSTAGRAM_MOCK_USERNAME=example_user
